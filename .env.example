# Spring runtime
SPRING_PROFILES_ACTIVE=dev
PORT=8081
SERVER_PORT=8081

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/walletdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# HikariCP pool tuning
DB_POOL_NAME=WalletServiceHikariPool
DB_POOL_AUTO_COMMIT=false
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
HIBERNATE_JDBC_FETCH_SIZE=50

# Local PostgreSQL container values
POSTGRES_DB=walletdb
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=change_me

# Gateway ingress guard
GATEWAY_INTERNAL_SECRET=change_me_to_a_long_random_shared_gateway_secret
GATEWAY_PUBLIC_ACTUATOR_ENDPOINTS=health,prometheus
ACTUATOR_OBSCURE_PATH=internal-probe-849284

# Auth and JWT
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET=change_me_to_a_256_bit_or_stronger_secret
JWT_EXPIRATION_ACCESS=300000
JWT_EXPIRATION_REFRESH=604800000
AUTHORIZED_SYSTEM_IDS=SYSTEM_TREASURY

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Brevo email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@example.com
MAIL_SENDER_NAME=Wallet Service

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
WALLET_KAFKA_ENABLED=true
WALLET_TRANSACTION_EVENTS_TOPIC=wallet.transaction.events.v1
WALLET_KAFKA_TOPIC_PARTITIONS=3
WALLET_KAFKA_MIN_IN_SYNC_REPLICAS=1
WALLET_KAFKA_TOPIC_REPLICAS=1
WALLET_KAFKA_TOPIC_RETENTION_MS=604800000
WALLET_KAFKA_TOPIC_CLEANUP_POLICY=delete
WALLET_KAFKA_CONSUMER_GROUP_ID=wallet-service-audit-consumer
WALLET_KAFKA_CONSUMER_CLIENT_ID=wallet-service-audit-consumer
WALLET_KAFKA_MAX_POLL_RECORDS=50
WALLET_KAFKA_AUDIT_CONSUMER_ENABLED=true
WALLET_KAFKA_CONSUMER_CONCURRENCY=1
WALLET_KAFKA_CONSUMER_RETRY_INTERVAL_MS=1000
WALLET_KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3

# Outbox publisher
WALLET_OUTBOX_PUBLISHER_ENABLED=true
WALLET_OUTBOX_BATCH_SIZE=50
WALLET_OUTBOX_FIXED_DELAY_MS=2000
WALLET_OUTBOX_MAX_ATTEMPTS=5
WALLET_OUTBOX_RETRY_DELAY_MS=60000
WALLET_OUTBOX_STALE_LOCK_TIMEOUT_MS=120000

# Async executor
WALLET_ASYNC_CORE_POOL_SIZE=2
WALLET_ASYNC_MAX_POOL_SIZE=8
WALLET_ASYNC_QUEUE_CAPACITY=100

# Observability
OTLP_METRICS_ENABLED=false
OTLP_GRAFANA_URL=
OTLP_GRAFANA_AUTH_HEADER=

# Docker build image overrides
MAVEN_IMAGE=docker.io/library/maven:3.9.6-eclipse-temurin-17
RUNTIME_IMAGE=docker.io/library/eclipse-temurin:17-jre-jammy
