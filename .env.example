# Database Configuration
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/walletdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password

# Runtime datasource and pool tuning
DB_POOL_NAME=WalletServiceHikariPool
DB_POOL_AUTO_COMMIT=false
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
HIBERNATE_JDBC_FETCH_SIZE=50

# Database Configuration (docker-compose)
POSTGRES_DB=walletdb
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=wallet_pass

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# JWT Secret
JWT_SECRET=your_base64_jwt_secret
JWT_EXPIRATION_ACCESS = xxx          // Short lived token (Access token) expiration in ms
JWT_EXPIRATION_REFRESH = xxx      // long lived token (refresh token) expiration in ms

# Razorpay Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
